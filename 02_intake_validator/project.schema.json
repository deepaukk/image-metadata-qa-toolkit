{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image Metadata Collection Schema (Demo)",
  "type": "object",
  "properties": {
    "Asset_ID": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "disambiguation_details": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Books and Media",
        "Clothing and Accessories",
        "Electronics and Devices",
        "Furniture",
        "Household Items",
        "Outdoor and Garden",
        "Time and Measurement"
      ]
    },
    "sub_category": {
      "type": "string",
      "enum": [
        "Bags and Luggage",
        "Books",
        "Clocks and Timers",
        "Footwear",
        "Kitchen Essentials",
        "Personal Devices",
        "Plants",
        "Seating",
        "Tables",
        "Tableware"
      ]
    },
    "indoor_outdoor": {
      "type": [
        "string",
        "null"
      ]
    },
    "Indoor Lighting": {
      "type": [
        "string",
        "null"
      ]
    },
    "Outdoor Lighting": {
      "type": [
        "string",
        "null"
      ]
    },
    "place_details": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "has_text": {
      "type": [
        "integer",
        "string",
        "boolean",
        "null"
      ]
    },
    "Language_Code": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "camera_make": {
      "type": [
        "string",
        "null"
      ]
    },
    "camera_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "Participant ID": {
      "type": [
        "string",
        "null"
      ]
    },
    "UUID": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "category",
    "sub_category"
  ],
  "additionalProperties": true
}